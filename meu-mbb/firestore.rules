rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function hasPermanentEmail() {
      return 'email' in request.auth.token
        && request.auth.token.email is string
        && !request.auth.token.email.lower().matches('.*@([a-z0-9-]+[.])*(mailinator[.]com|guerrillamail[.]com|yopmail[.]com|tempmail[.]com|10minutemail[.]com|sharklasers[.]com|trashmail[.]com|maildrop[.]cc|getnada[.]com|dispostable[.]com|moakt[.]com|tempr[.]email)');
    }
    function validNoteAt(index) {
      return request.resource.data.notas.size() <= index
        || (request.resource.data.notas[index] is string
          && request.resource.data.notas[index].size() >= 1
          && request.resource.data.notas[index].size() <= 2000);
    }
    function validNotes() {
      return !('notas' in request.resource.data)
        || (request.resource.data.notas is list
          && request.resource.data.notas.size() <= 10
          && validNoteAt(0) && validNoteAt(1) && validNoteAt(2)
          && validNoteAt(3) && validNoteAt(4) && validNoteAt(5)
          && validNoteAt(6) && validNoteAt(7) && validNoteAt(8)
          && validNoteAt(9));
    }

    match /meuMbb/{uid}/registros/{conteudoId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.auth.token.email_verified == true
        && hasPermanentEmail()
        && request.resource.data.keys().hasOnly([
          'conteudoId', 'versaoVista', 'atualizadoEm', 'ultimoAcesso',
          'ancora', 'concluido', 'favorito', 'anotacao', 'notas'
        ])
        && request.resource.data.keys().hasAll(['conteudoId', 'versaoVista', 'atualizadoEm'])
        && request.resource.data.conteudoId == conteudoId
        && conteudoId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && conteudoId.size() <= 100
        && request.resource.data.versaoVista is int
        && request.resource.data.versaoVista >= 1
        && request.resource.data.atualizadoEm == request.time
        && (!('ultimoAcesso' in request.resource.data) || request.resource.data.ultimoAcesso is timestamp)
        && (!('ancora' in request.resource.data) || (request.resource.data.ancora is string && request.resource.data.ancora.size() <= 100))
        && (!('concluido' in request.resource.data) || request.resource.data.concluido is bool)
        && (!('favorito' in request.resource.data) || request.resource.data.favorito is bool)
        && (!('anotacao' in request.resource.data) || (request.resource.data.anotacao is string && request.resource.data.anotacao.size() <= 2000))
        && validNotes();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "cafe-aurora-servicos-locais",
  "private": true,
  "type": "module",
  "scripts": {
    "emuladores": "firebase emulators:start --project demo-cafe-aurora-web3 --export-on-exit=./dados-emuladores",
    "test": "firebase emulators:exec --project demo-cafe-aurora-web3 --only firestore,auth,storage \"node --test tests/*.test.mjs\"",
    "preparar": "node scripts/preparar-local.mjs",
    "test:integracoes": "firebase emulators:exec --project demo-cafe-aurora-web3 --only firestore,auth,storage,functions \"node tests/integracoes.local.mjs\"",
    "retomar": "firebase emulators:start --project demo-cafe-aurora-web3 --import=./dados-emuladores --export-on-exit=./dados-emuladores"
  },
  "devDependencies": {
    "firebase-tools": "15.34.1",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "@firebase/rules-unit-testing": "5.0.2"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "@opentelemetry/core": "2.8.0",
    "uuid": "11.1.1"
  }
}

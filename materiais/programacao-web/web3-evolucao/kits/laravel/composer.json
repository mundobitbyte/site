{
  "name": "mundobitbyte/cafe-aurora-laravel",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.17",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5.12",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "src/repositorio-mensagens.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist"
  }
}
